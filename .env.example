# ===== Telegram =====
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here

# ===== Claude API =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_TIMEOUT_SECONDS=540
# Повторы SDK при 429/529/5xx и сетевых ошибках (экспоненциальная задержка)
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_GLOBAL_CONCURRENCY=4
# Модель (Haiku 5.5 / Sonnet 5.5 / Opus 5.5) и уровень размышлений
# выбирает администратор командой /model. Цены моделей заданы в коде:
# bot/utils/anthropic/models.py

# ===== Системный промпт =====
SYSTEM_PROMPT=Ты полезный ассистент. Текущее время передаётся в каждом сообщении.

# ===== Часовой пояс по умолчанию =====
DEFAULT_TIMEZONE=Europe/Moscow

# ===== Контекст и саммаризация =====
# Рабочий бюджет контекста (не больше окна модели — 1M токенов). Больше бюджет —
# больше дословной истории, но каждое сообщение дороже и медленнее.
# У Haiku 5.5 промпт > 100K токенов тарифицируется в 5 раз дороже.
CONTEXT_BUDGET_TOKENS=300000
SUMMARY_TRIGGER_TOKENS=0.85    # порог заполнения бюджета контекста (0..1)
# Время жизни кэша промпта: 5m | 1h. Запись в часовой кэш дороже (2x против 1.25x
# от цены входа), но он переживает паузы до часа между сообщениями.
CACHE_TTL=1h
SUMMARY_TRIGGER_HOURS=72       # часов тишины для триггера по времени
SUMMARY_KEEP_LAST=10           # последних диалогов (пар) не сжимать

# ===== Лимиты =====
MAX_FILE_MB=20
MAX_LOG_MB=5

# ===== Напоминания =====
REMINDER_POLL_INTERVAL=10s
REMINDER_BATCH_LIMIT=50
REMINDER_LOOKAHEAD=2s
REMINDER_JITTER=2s
REMINDER_DEFAULT_SILENT=1

# ===== Резервные копии базы =====
# Ежедневная копия в папку backups/ (сжатая), старые удаляются
BACKUP_HOUR=1          # после какого часа по UTC делать копию (1 = 04:00 МСК)
BACKUP_KEEP=14         # сколько копий хранить на сервере
BACKUP_SEND_DAYS=7     # раз в сколько дней присылать копию админу в Telegram (0 — не присылать)

# ===== Режим отладки =====
DEBUG_MODE=0
# Баг-репорты: ошибки из логов (с трейсбеком) отправляются администратору в Telegram.
# Одинаковые ошибки не чаще раза в 15 минут, с числом повторов.
BUG_REPORTS=1

# ===== Веб-поиск =====
# SEARCH_ENGINE: ddgs | searxng | auto | native
#   ddgs    — бесплатный метапоиск ddgs, запасной — SearXNG (рекомендуется)
#   searxng — бесплатный SearXNG, запасной — ddgs
#   auto    — SearXNG, а пока он недоступен — платный нативный Anthropic web_search
#             (SearXNG перепроверяется раз в 5 минут)
#   native  — только нативный Anthropic web_search ($0.01/запрос + токены результатов)
# Если основной движок упал или ничего не нашёл, бот сам спрашивает запасной.
SEARCH_ENGINE=ddgs
# Движки SearXNG: на IP дата-центра Google, DuckDuckGo, Brave, Startpage блокируют,
# а Яндекс и Bing отвечают
SEARXNG_ENGINES=yandex,bing

# ===== Чтение веб-страниц (web_fetch Anthropic) =====
# Бот открывает страницу или PDF по ссылке из диалога (из сообщения или результатов поиска).
# Отдельной платы нет — только токены текста страницы (обычная страница ~2500 токенов).
WEB_FETCH=1
WEB_FETCH_MAX_TOKENS=20000     # предел текста одной страницы (на PDF не действует)
WEB_FETCH_MAX_USES=5           # сколько страниц можно открыть за один ответ
SEARXNG_URL=http://localhost:8888
